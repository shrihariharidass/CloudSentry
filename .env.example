# CloudSentry Environment Variables
# Copy this file to .env and fill in your values

# AWS Configuration
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# S3 Bucket (created by Terraform)
C7N_S3_BUCKET=custodian-results-123456789012
C7N_S3_PREFIX=policies/

# Local output directory (fallback when S3 is unavailable)
C7N_LOCAL_OUTPUT=../output

# Dashboard port
PORT=5000
